# MySQL connection string for the Hostinger database
# e.g. mysql://user:password@localhost:3306/dbname
DATABASE_URL=

# Port to bind to. Hostinger's Node.js app manager sets this automatically;
# only set it manually for local/VPS runs.
PORT=3000

NODE_ENV=production

# Kit (ConvertKit): legacy. Signups now go to Hostinger Reach via its embedded
# form (see shared/reach.ts), so these are no longer needed.
KIT_API_KEY=
KIT_FORM_ID=9625620

# Gumroad — live access token used server-side to fetch the product catalog
# for the store page. Create under Gumroad > Settings > Advanced > Applications.
GUMROAD_TOKEN=

# Legacy/unused — only needed if you reintroduce Manus-hosted auth or storage.
# JWT_SECRET=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Public site URL used in canonical links, the sitemap and robots.txt.
# Defaults to https://buildyourdigitalcity.com if unset.
# SITE_URL=https://buildyourdigitalcity.com
